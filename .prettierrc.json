{
  "useTabs": true,
  "tabWidth": 4,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.json", "*.md", "*.yaml", "*.yml"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ],
  "tailwindStylesheet": "./src/app/globals.css"
}
